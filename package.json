{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" tsx server.ts",
    "build": "NODE_OPTIONS=\"--max-old-space-size=2048\" npx --no-install vite build && npx --no-install esbuild server.ts --bundle --platform=node --target=node22 --format=cjs --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=dist/server.cjs && node scripts/prepare-build-artifact.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist build",
    "deploy:cloudrun": "bash deploy-cloudrun.sh",
    "push:github": "bash push-to-github.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/compression": "1.8.1",

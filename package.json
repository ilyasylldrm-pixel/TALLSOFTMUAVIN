    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-react": "5.2.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "autoprefixer": "10.6.1",
    "compression": "1.8.2",
    "d3": "7.9.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "0.25.12",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "jsqr": "1.4.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",

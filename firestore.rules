rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ilyasyildirim@outlook.com.tr" ||
        request.auth.token.email == "ilyasylldrm@gmail.com" ||
        request.auth.token.email.matches('.*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 254));
    }

    function isValidUserFile(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255));
    }

    // User Profiles Collection: Allow reading/listing and updating profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if isSignedIn() || true;
    }

    // User Files & Metadata Collection: Allow reading/listing user files and admin file management
    match /user_files/{fileId} {
      allow read: if true;
      allow create, update: if isValidUserFile(request.resource.data);
      allow delete: if true;
    }

    // Administrative Roles Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // Central System Settings (Payroll parameters, legal tariffs, shared config)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Central System Audit Logs (Admin update ledger)
    match /system_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Broadcast Announcements (System notifications sent to all users)
    match /broadcast_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback collection permissions
    match /{document=**} {
      allow read, write: if true;
    }
  }
}




# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mysoft e-Belge İş Ortağı API (sunucu tarafı; tarayıcıya koymayın).
# Eşleştirme Masasında eşleşen tüm şirketlerin e-Belge işlemleri İş Ortağı OAuth2 anahtarı üzerinden yürütülür.
MYSOFT_ENV=prod
MYSOFT_PARTNER_CLIENT_ID=
MYSOFT_PARTNER_CLIENT_SECRET=
MYSOFT_CLIENT_ID=
MYSOFT_CLIENT_SECRET=
# Varsayılan firma VKN/TCKN (eşleşen şirketlerde otomatik olarak şirketin kendi VKN/TCKN'si kullanılır):
# MYSOFT_TENANT_IDENTIFIER_NUMBER=
# Kimlik bilgisi yokken demo fixture göstermek için:
# MYSOFT_MOCK_MODE=true

# Trendyol pazaryeri entegrasyonu (sunucu tarafı)
# Firma API bilgilerini Muavin ekranından girer; burada yalnızca sistem ayarları var.
# Kayıtlı API Secret'ları şifrelemek için uzun rastgele bir değer (DEĞİŞTİRİLİRSE kayıtlı bilgiler okunamaz):
TRENDYOL_SECRET_KEY=
# User-Agent'ta görünen entegratör adı (alfanümerik, en fazla 30). Boşsa "SelfIntegration".
# TRENDYOL_INTEGRATOR_NAME=TallsoftMuavin
# VPS/PM2: süreç içi zamanlayıcı ile otomatik faturalama
# TRENDYOL_AUTO_SYNC=true
# TRENDYOL_SYNC_INTERVAL_MINUTES=15
# Cloud Run: Cloud Scheduler -> POST /api/marketplace/trendyol/cron (x-cron-secret başlığı)
# TRENDYOL_CRON_SECRET=
# Depo dosyası (kalıcı diske bağlayın): varsayılan data/trendyol_store.json
# TRENDYOL_STORE_PATH=

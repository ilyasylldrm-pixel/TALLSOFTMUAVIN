# ============================================================================
# MERKEZİ İSTEMCİ & API BAĞLANTI AYARLARI (Tarayıcı / Vite)
# ============================================================================
# Tüm bilgisayarlarda ve alt dizinlerde göreceli çalışması için varsayılan "."
VITE_API_BASE_URL="."
# Yeni sürüm (version.json) kontrol periyodu (milisaniye, varsayılan: 60000)
VITE_VERSION_CHECK_INTERVAL_MS="60000"
# Merkezi senkronizasyon yoklama aralığı (milisaniye, varsayılan: 12000)
VITE_CENTRAL_SYNC_POLL_MS="12000"

# ============================================================================
# MERKEZİ SUNUCU VERİ DEPOSU & BULUT VERİTABANI AYARLARI (Sunucu Tarafı)
# ============================================================================
# Merkezi JSON veri deposu dosya yolu (kalıcı disk veya paylaşımlı dizin)
CENTRAL_STORE_PATH="data/cloud_sync_store.json"
# Sunucu tarafı tarayıcı oturum deposu (git dışı tutulur)
CENTRAL_SESSIONS_PATH="data/central_sessions.json"
# Hassas çalışma zamanı anahtarları deposu (git dışı tutulur)
CENTRAL_SECRETS_PATH="data/central_secrets.json"
# PostgreSQL / Cloud SQL / Supabase bağlantı adresi (opsiyonel merkezi RDBMS)
DATABASE_URL=""
# Firebase / Firestore proje kimliği (opsiyonel sunucu doğrulaması için)
FIREBASE_PROJECT_ID=""

# ============================================================================
# GEMINI AI & UYGULAMA ÇALIŞMA ORTAMI
# ============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ============================================================================
# MYSOFT E-BELGE İŞ ORTAĞI API (Sunucu Tarafı)
# ============================================================================
MYSOFT_ENV="prod"
MYSOFT_PARTNER_CLIENT_ID=""
MYSOFT_PARTNER_CLIENT_SECRET=""
MYSOFT_CLIENT_ID=""
MYSOFT_CLIENT_SECRET=""
# MYSOFT_TENANT_IDENTIFIER_NUMBER=""
# MYSOFT_MOCK_MODE="true"

# ============================================================================
# TRENDYOL & PAZARYERİ ENTEGRASYONU (Sunucu Tarafı)
# ============================================================================
TRENDYOL_SECRET_KEY=""
